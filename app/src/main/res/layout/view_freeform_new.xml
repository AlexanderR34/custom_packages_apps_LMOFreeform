<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/freeform_container_new"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/actionSubmenuView"
        android:tag="actionSubmenuView"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/hyperos_submenu_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:visibility="gone"
        android:elevation="14dp">

        <FrameLayout
            android:id="@+id/btnFullscreen"
            android:tag="btnFullscreen"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/hyperos_btn_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hyperos_fullscreen"
                android:contentDescription="Pantalla completa" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSplitTop"
            android:tag="btnSplitTop"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/hyperos_btn_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hyperos_split_top"
                android:contentDescription="Pantalla dividida superior" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSplitBottom"
            android:tag="btnSplitBottom"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/hyperos_btn_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hyperos_split_bottom"
                android:contentDescription="Pantalla dividida inferior" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnMiniWindow"
            android:tag="btnMiniWindow"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/hyperos_btn_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hyperos_mini_window"
                android:contentDescription="Pantalla minimizada" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnClose"
            android:tag="btnClose"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/hyperos_btn_bg"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hyperos_close"
                android:contentDescription="Cerrar ventana emergente" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/window_body_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.cardview.widget.CardView
            android:id="@+id/windowCard"
            android:tag="windowCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/color_surface">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/freeform_root"
                    android:tag="freeform_root"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:id="@+id/veilView"
                    android:tag="veilView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_surface"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/veilAppIcon"
                        android:tag="veilAppIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/topBarView"
                    android:tag="topBarView"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_gravity="top"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/threeDotsHandle"
                        android:tag="threeDotsHandle"
                        android:layout_width="56dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/ic_hyperos_three_dots"
                        android:contentDescription="Opciones de ventana" />
                </FrameLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/leftScaleView"
            android:tag="leftScaleView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-6dp"
            android:layout_marginBottom="-6dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/hyperos_corner_left" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/rightScaleView"
            android:tag="rightScaleView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-6dp"
            android:layout_marginBottom="-6dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/hyperos_corner_right" />
        </FrameLayout>

    </FrameLayout>

    <ImageView
        android:id="@+id/appIcon"
        android:tag="appIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/packageName"
        android:tag="packageName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/maximizeView"
        android:tag="maximizeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/minimizeView"
        android:tag="minimizeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/pinView"
        android:tag="pinView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/bottomBarView"
        android:tag="bottomBarView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/arrowBack"
        android:tag="arrowBack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
