<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/freeform_container_new"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Window Card with dedicated Header Bar & App Surface -->
    <androidx.cardview.widget.CardView
        android:id="@+id/windowCard"
        android:tag="windowCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/color_surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dedicated Header Bar: contains Three Dots Handle & Submenu in place -->
            <FrameLayout
                android:id="@+id/headerContainer"
                android:tag="headerContainer"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@android:color/transparent">

                <FrameLayout
                    android:id="@+id/topBarView"
                    android:tag="topBarView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/threeDotsHandle"
                        android:tag="threeDotsHandle"
                        android:layout_width="56dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_hyperos_three_dots"
                        android:contentDescription="Opciones de ventana" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/actionSubmenuView"
                    android:tag="actionSubmenuView"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/hyperos_submenu_bg"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/btnFullscreen"
                        android:tag="btnFullscreen"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginHorizontal="1.5dp"
                        android:background="@drawable/hyperos_btn_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hyperos_fullscreen"
                            android:contentDescription="Pantalla completa" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnSplitTop"
                        android:tag="btnSplitTop"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginHorizontal="1.5dp"
                        android:background="@drawable/hyperos_btn_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hyperos_split_top"
                            android:contentDescription="Pantalla dividida superior" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnSplitBottom"
                        android:tag="btnSplitBottom"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginHorizontal="1.5dp"
                        android:background="@drawable/hyperos_btn_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hyperos_split_bottom"
                            android:contentDescription="Pantalla dividida inferior" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnMiniWindow"
                        android:tag="btnMiniWindow"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginHorizontal="1.5dp"
                        android:background="@drawable/hyperos_btn_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hyperos_mini_window"
                            android:contentDescription="Pantalla minimizada" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnClose"
                        android:tag="btnClose"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginHorizontal="1.5dp"
                        android:background="@drawable/hyperos_btn_bg"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hyperos_close"
                            android:contentDescription="Cerrar ventana emergente" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- App Surface & Veil Container -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/freeform_root"
                    android:tag="freeform_root"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:id="@+id/veilView"
                    android:tag="veilView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_surface"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/veilAppIcon"
                        android:tag="veilAppIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center" />
                </FrameLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom-Left Concentric Curved Corner Arc Resizer -->
    <FrameLayout
        android:id="@+id/leftScaleView"
        android:tag="leftScaleView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="0dp"
        android:layout_marginBottom="0dp"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:src="@drawable/hyperos_corner_left" />
    </FrameLayout>

    <!-- Bottom-Right Concentric Curved Corner Arc Resizer -->
    <FrameLayout
        android:id="@+id/rightScaleView"
        android:tag="rightScaleView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/hyperos_corner_right" />
    </FrameLayout>

    <!-- Floating App Icon Bubble (when contracted further from mini mode) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/floatingIconCard"
        android:tag="floatingIconCard"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        app:cardCornerRadius="28dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="@color/color_surface"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/floatingAppIcon"
            android:tag="floatingAppIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="Icono flotante" />
    </androidx.cardview.widget.CardView>

    <!-- Compatibility dummy views -->
    <ImageView
        android:id="@+id/appIcon"
        android:tag="appIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/packageName"
        android:tag="packageName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/maximizeView"
        android:tag="maximizeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/minimizeView"
        android:tag="minimizeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/pinView"
        android:tag="pinView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/bottomBarView"
        android:tag="bottomBarView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/arrowBack"
        android:tag="arrowBack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
